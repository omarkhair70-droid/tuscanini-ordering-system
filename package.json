{
  "name": "tuscanini-ordering-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "seed:phase7_2:menu": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seeds/phase_7_2_menu_seed.sql",
    "verify:phase7_2:menu": "tsc --pretty false --target es2020 --module commonjs --esModuleInterop --outDir .tmp/scripts scripts/supabase/verify_menu_seed_parity.ts && node .tmp/scripts/verify_menu_seed_parity.js",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@tailwindcss/postcss": "4.3.3"
  }
}
